ırıncı Aslan|🐨 Pastacı Koala|🐼 Parlak Panda|🦊 Nazik Tilki|🦘 Çevik Kanguru|🐯 Gayretli Kaplan|🦁 Sabırlı Aslan|🐻 Özenli Ayıcık|🐨 Neşeli Koala|🐰 Neşeli Tavşan|🐱 Sevimli Kedi|🐧 Minik Penguen|🦉 Zarif Baykuş|🦅 Minik Kartal|🐬 Parlak Yunus|🦒 Nazik Zürafa|🦓 Çevik Zebra|🦄 Gayretli Tekboynuz|🦖 Sabırlı Dinozor|🐙 Özenli Ahtapot|🦋 Sakin Kelebek|🐝 Neşeli Arı|🐞 Sevimli Uğurböceği|🦜 Şirin Papağan|🐿️ Parlak Sincap|🦔 Çevik Kirpi|🦌 Sabırlı Geyik|🐴 Çevik At|🦈 Gayretli Köpekbalığı|🐊 Sabırlı Timsah|🦩 Özenli Flamingo|🐹 Sakin Hamster|🐸 Neşeli Kurbağa|🐠 Sevimli Balık|🐆 Şirin Çita|🦚 Zarif Tavuskuşu|🦦 Minik Susamuru|🦀 Parlak Yengeç|🍎 Lezzetli Elma|🍊 Parlak Portakal|🍋 Zarif Limon|🍉 Minik Karpuz|🍇 Sevimli Üzüm|🍓 Şirin Çilek|🍒 Renkli Kiraz|🥭 Neşeli Mango|🍍 Güzel Ananas|🥥 Şık Hindistancevizi|🥝 Taze Kivi|🍈 Lezzetli Kavun|🍅 Parlak Domates|🥑 Zarif Avokado|🥦 Minik Brokoli|🥬 Şık Marul|🌶️ Şirin Biber|🥕 Neşeli Havuç|🧄 Güzel Sarımsak|🧅 Şık Soğan|🥔 Taze Patates|🌰 Lezzetli Kestane|🍕 Parlak Pizza|🍔 Güzel Hamburger|🍟 Minik Kızartma|🧁 Şirin Kek|🍩 Güzel Donut|🍪 Şık Kurabiye|🍫 Taze Çikolata|🍬 Güzel Şeker|🍭 Parlak Lolipop|🍦 Zarif Dondurma|🥞 Minik Pankek|🧇 Sevimli Waffle|🥐 Şirin Kruvasan|🍯 Neşeli Bal|🥛 Şirin Süt|🍞 Şık Ekmek|🥪 Taze Sandviç|🍝 Lezzetli Makarna|🍜 Parlak Çorba|🥗 Zarif Salata|🥧 Sevimli Turta|🌙 Renkli Ay|☀️ Neşeli Güneş|🌈 Şık Gökkuşağı|⚡ Şık Şimşek|🌋 Parlak Yanardağ|🌊 Zarif Deniz|🔥 Minik Alev|🌪️ Sevimli Kasırga|🌍 Renkli Dünya|🪐 Renkli Satürn|☄️ Neşeli Kuyrukluyıldız|💎 Güzel Elmas|☁️ Şık Bulut|🏔️ Parlak Dağ|🌻 Minik Ayçiçeği|🌷 Sevimli Lale|🌹 Şirin Gül|🌺 Renkli Çiçek|🌼 Neşeli Papatya|💐 Güzel Buket|🌳 Canlı Çınar|🌲 Parlak Çam|🍀 Minik Yonca|🌱 Şirin Filiz|🌾 Renkli Başak|🌿 Neşeli Nane|🚀 Güzel Roket|🚗 Şık Araba|✈️ Minik Uçak|🚁 Sevimli Helikopter|🚲 Şirin Bisiklet|⛵ Renkli Yelkenli|🚢 Neşeli Gemi|🚒 Güzel İtfaiye|🚑 Şık Ambulans|🚌 Parlak Otobüs|🚜 Zarif Traktör|🛵 Minik Mobilet|🛴 Sevimli Scooter|🚤 Şirin Tekne|🚠 Renkli Teleferik|🏍️ Güzel Motosiklet|🛶 Şık Kano|⚽ Canlı Futbol|🏀 Parlak Basketbol|🏈 Zarif Ragbi|🏐 Minik Voleybol|🎾 Sevimli Tenis|⚾ Şirin Beyzbol|🏓 Renkli Pinpon|🏸 Neşeli Badminton|🥋 Güzel Kuşak|⛸️ Şık Paten|🛹 Canlı Kaykay|🎳 Parlak Bowling|⛳ Zarif Golf|🎯 Minik Hedef|🏆 Sevimli Kupa|🥇 Şirin Madalya|🎿 Renkli Kayak|🏒 Neşeli Hokey|🎸 Şık Gitar|🎹 Canlı Piyano|🐥 Sevimli Civciv|🎻 Zarif Keman|🥁 Minik Davul|🎷 Sevimli Saksafon|🎤 Şirin Mikrofon|🎧 Renkli Kulaklık|🎨 Neşeli Palet|🖌️ Güzel Fırça|🎭 Şık Maske|🎬 Canlı Klaket|📷 Parlak Kamera|🎵 Zarif Nota|🖍️ Minik Pastel|👽 Şirin Uzaylı|🛸 Şirin Ufo|🤖 Renkli Robot|🛰️ Güzel Uydu|🔭 Şık Teleskop|🌌 Canlı Galaksi|⚙️ Parlak Çark|🔋 Zarif Pil|📡 Minik Anten|🧲 Şirin Mıknatıs|💡 Renkli Ampul|🏰 Neşeli Şato|🗼 Şık Kule|🎡 Zarif Dolap|🎠 Zarif Atlıkarınca|⛺ Minik Çadır|🏝️ Sevimli Ada|🏖️ Şirin Plaj|🏕️ Renkli Orman|🏟️ Neşeli Stadyum|🏠 Güzel Yuva|🏡 Şık Ev|🌉 Canlı Köprü|⛲ Parlak Fıskiye|🏫 Şirin Okul|🏛️ Minik Müze|🏜️ Şirin Çöl)( #[0-9]{1,4})?$'));
  }
  function odaAdOk(d) {
   return !('ad' in d) || d.ad in ['Hızlılar','Şefler','Mutfak Ekibi','Sınıf yarışı','Tatlıcılar','Servis Ekibi'] || d.ad == d.hostNick + ' ile oyna';
  }
  /* ---------- Birlikte Oynayalım (oyun odaları, v16) ----------
     Yeni sistem ayrı koleksiyondadır: oyunOdalari/{KOD}. Eski raceRooms sistemi kaldırıldı; kuralları da silindi.
     Odayı öğrenci kurar ve oynar. Kapışmada ikinci oyuncu "guest" alanını tek işlemde alır; üçüncü kişi giremez. */
  match /oyunOdalari/{code} {
   function room() { return get(/databases/$(database)/documents/oyunOdalari/$(code)).data; }
   function member() { return signed() && exists(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(request.auth.uid)); }
   function recent(ms) { return request.time.toMillis() - ms < 86400000; }
   function arena2() { return room().mode == 'arena' && ('av' in room()) && room().av == 2; }
   function arenaErrorLimit() { return room().rev.matches('^arena5-.*') ? 12 : (room().rev.matches('^arena[34]-.*') ? 7 : 4); }
   function rosterReady(d) {
    return d.roster is list && d.roster.size() >= 3 && d.roster.size() <= (resource.data.rev.matches('^arena[45]-.*') ? 10 : 4) && d.roster.size() == resource.data.cnt
     && d.roster.toSet().size() == d.roster.size() && request.auth.uid in d.roster
     && get(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(d.roster[0])).data.loaded == true
     && get(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(d.roster[1])).data.loaded == true
     && get(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(d.roster[2])).data.loaded == true
     && (d.roster.size() <= 3 || get(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(d.roster[3])).data.loaded == true)
     && (d.roster.size() <= 4 || get(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(d.roster[4])).data.loaded == true)
     && (d.roster.size() <= 5 || get(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(d.roster[5])).data.loaded == true)
     && (d.roster.size() <= 6 || get(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(d.roster[6])).data.loaded == true)
     && (d.roster.size() <= 7 || get(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(d.roster[7])).data.loaded == true)
     && (d.roster.size() <= 8 || get(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(d.roster[8])).data.loaded == true)
     && (d.roster.size() <= 9 || get(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(d.roster[9])).data.loaded == true);
   }
   allow get: if signed();
   /* Lobi (12.11): yalnız listede görünmesi istenen ve henüz başlamamış odalar listelenir. */
   allow list: if signed() && resource.data.pub == true && resource.data.status == 'lobby';
   allow create: if signed() && code.matches('^[A-Z0-9]{3,10}$')
    && request.resource.data.keys().hasOnly(['host','hostNick','mode','subject','kind','set','n','lim','seed','rev','created','status','guest','qv','cnt','scope','av','roster','pub','ad','kilit'])
    && (!('pub' in request.resource.data) || request.resource.data.pub is bool)
    && (!('kilit' in request.resource.data) || request.resource.data.kilit is bool)
    && odaAdOk(request.resource.data)
    && request.resource.data.keys().hasAll(['host','hostNick','mode','subject','kind','set','n','lim','seed','rev','created','status','guest','qv'])
    && request.resource.data.host == request.auth.uid && request.resource.data.status == 'lobby' && request.resource.data.guest == null
    && request.resource.data.mode in ['race','duel','arena']
    && request.resource.data.subject in ['baharat','mutfak-araclari','bulasik-makinesi-temizligi','kuver']
    && (!('scope' in request.resource.data) || request.resource.data.scope in ['tek','konu','butun'])
    && request.resource.data.kind in ['gorsel','bilgi','kuver']
    && request.resource.data.set is int && request.resource.data.set >= 0 && request.resource.data.set <= 12
    && request.resource.data.n is int && (request.resource.data.mode == 'arena'
      ? (request.resource.data.av == 2 && request.resource.data.roster == [] && request.resource.data.kind == 'gorsel' && request.resource.data.set == 0 && request.resource.data.cnt == 1
         && ((request.resource.data.rev.matches('^arena2-.*') && request.resource.data.lim == 15 && request.resource.data.n == 75 && request.resource.data.scope == 'butun' && request.resource.data.subject == 'mutfak-araclari')
          || ((request.resource.data.rev.matches('^arena3-.*') && request.resource.data.lim == 15 || request.resource.data.rev.matches('^arena[45]-.*') && request.resource.data.lim == 20) && request.resource.data.n >= 3 && request.resource.data.n <= (request.resource.data.rev.matches('^arena5-.*') ? 100 : 75)
           && (request.resource.data.scope == 'konu' || (request.resource.data.scope == 'butun' && request.resource.data.subject == 'mutfak-araclari')))))
      : (!request.resource.data.keys().hasAny(['av','roster']) && request.resource.data.n >= 3 && request.resource.data.n <= 20))
    && request.resource.data.lim in [15,20,30]
    && request.resource.data.seed is int && request.resource.data.seed >= 0 && request.resource.data.seed <= 4294967295
    && request.resource.data.rev is string && request.resource.data.rev.size() <= 40
    && adOk(request.resource.data.hostNick)
    && request.resource.data.qv == 1
    && (!('cnt' in request.resource.data) || ((request.resource.data.mode == 'race' || request.resource.data.mode == 'arena') && request.resource.data.cnt == 1))
    && request.resource.data.created is int && request.resource.data.created > request.time.toMillis() - 3600000 && request.resource.data.created < request.time.toMillis() + 3600000;
   allow update: if signed() && (
    (resource.data.host == request.auth.uid && resource.data.status == 'lobby' && request.resource.data.status == 'playing'
      && ((resource.data.mode == 'arena' && ('av' in resource.data) && resource.data.av == 2)? (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','roster']) && rosterReady(request.resource.data)) : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])))
    || (resource.data.mode == 'duel' && resource.data.status == 'lobby' && resource.data.host != request.auth.uid
      && resource.data.guest == null && request.resource.data.guest == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest']))
    || (resource.data.mode in ['race','arena'] && resource.data.status == 'lobby' && resource.data.host != request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cnt'])
      && request.resource.data.cnt is int && request.resource.data.cnt >= 1 && request.resource.data.cnt <= (resource.data.mode == 'arena' ? (resource.data.rev.matches('^arena[45]-.*') ? 10 : 4) : 8)
      && ((request.resource.data.cnt == resource.data.cnt + 1
            && existsAfter(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(request.auth.uid))
            && !exists(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(request.auth.uid)))
        || (request.resource.data.cnt == resource.data.cnt - 1
            && exists(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/oyunOdalari/$(code)/players/$(request.auth.uid))))));
   allow delete: if signed() && (resource.data.host == request.auth.uid || !recent(resource.data.created));

   match /players/{uid} {
    function shape(d) {
     return d.keys().hasOnly(['nick','score','ok','bad','n','tt','done','ts','rid','m','r','pr','pid','ready','loaded','left','sf'])
      && (!('sf' in d) || (d.sf is string && d.sf.size() <= 4))
      && d.keys().hasAll(['nick','score','ok','bad','n','tt','done','ts','rid'])
      && adOk(d.nick)
      && d.score is int && d.score >= 0 && d.score <= (arena2()?100:60)
      && d.ok is int && d.ok >= 0 && d.ok <= (arena2()?100:60) && d.bad is int && d.bad >= 0 && d.bad <= (arena2()?arenaErrorLimit():60)
      && d.n is int && d.n >= 0 && d.n <= (arena2()?100:60) && d.n <= room().n && d.ok + d.bad <= d.n && d.tt is int && d.tt >= 0
      && (!('loaded' in d) || d.loaded is bool)
      && (!('ready' in d) || d.ready is bool)
      && d.done is bool && d.ts is int && d.rid == room().created
      && (!('m' in d) || (d.m is int && d.m >= 0 && d.m <= 50))
      && (!('r' in d) || (d.r is list && d.r.size() <= (arena2()?100:60)))
      && (!('pr' in d) || (d.pr is list && d.pr.size() <= 60))
      && (arena2()? (d.keys().hasAll(['r','left']) && d.left is bool && d.r.size() == d.n && d.ok + d.bad == d.n && d.score == d.ok) : !d.keys().hasAny(['left']))
      && (!('pid' in d) || (yrPidOk(d.pid) && yrKimOk(uid) && get(/databases/$(database)/documents/yrKim/$(uid)).data.pid == d.pid));
    }
    function arenaProgress(d) {
     let o = resource.data;
     let v = d.n > 0 ? d.r[d.n-1] : 0;
     let ms = v > 0 ? v : -v;
     let modern = room().rev.matches('^arena[45]-.*');
     let sec = (modern ? 20 : 15) - int(o.ok / (modern ? 6 : 5));
     return d.nick == o.nick && d.ts <= request.time.toMillis()+60000 && d.ts >= request.time.toMillis()-60000
      && (o.done
       ? d.diff(o).affectedKeys().hasOnly(['ts'])
       : ((d.n == o.n && d.r == o.r && d.ok == o.ok && d.bad == o.bad && d.tt == o.tt
            && ((d.done == o.done && !d.left) || (room().status == 'playing' && d.done && d.left)))
          || (room().status == 'playing' && d.n == o.n+1 && d.r == o.r.concat([v]) && v is int && v != 0 && ms <= (sec < 7 ? 7000 : sec*1000)
            && d.tt == o.tt+ms && d.ok == o.ok+(v>0?1:0) && d.bad == o.bad+(v<0?1:0)
            && !d.left && d.done == (d.bad == arenaErrorLimit() || d.n == room().n))));
    }
    allow get: if signed() && (request.auth.uid == uid || member());
    allow list: if signed() && member();
    allow create: if signed() && request.auth.uid == uid && room().status == 'lobby'
     && (room().mode in ['race','arena'] || room().host == uid || room().guest == uid || getAfter(/databases/$(database)/documents/oyunOdalari/$(code)).data.guest == uid)
     /* Şifreli oda: kurucu dışında giren, şifreyi oyuncu kaydında getirir; şifre okunamayan gizli/sifre belgesiyle karşılaştırılır. */
     && (!('kilit' in room()) || room().kilit != true || room().host == uid
         || request.resource.data.sf == get(/databases/$(database)/documents/oyunOdalari/$(code)/gizli/sifre).data.s)
     && shape(request.resource.data) && (!arena2() || (request.resource.data.n == 0 && request.resource.data.tt == 0 && !request.resource.data.done && !request.resource.data.left));
    allow update: if signed() && request.auth.uid == uid && room().status in ['lobby','playing'] && shape(request.resource.data)
     && (!arena2() || arenaProgress(request.resource.data));
    allow update: if signed() && request.auth.uid != uid && member() && arena2() && room().status == 'playing'
     && !resource.data.done && request.time.toMillis()-resource.data.ts > 60000
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done','left'])
     && request.resource.data.done == true && request.resource.data.left == true;
    allow delete: if signed() && (request.auth.uid == uid || room().host == request.auth.uid) && (!arena2() || room().status == 'lobby');
   }
   /* Oda şifresi: yalnız kurucu yazar ve siler. Öğrenciler okuyamaz; odaya girmiş oyuncular arkadaşına söyleyebilsin diye görebilir. */
   match /gizli/{k} {
    allow get: if signed() && k == 'sifre' && member();
    allow create: if signed() && k == 'sifre' && room().host == request.auth.uid && room().status == 'lobby'
     && request.resource.data.keys().hasOnly(['s']) && request.resource.data.s is string && request.resource.data.s.matches('^[0-9]{4}$');
    allow delete: if signed() && (room().host == request.auth.uid || !recent(room().created));
   }
  }

  /* ---------- Bireysel rekor ve sıralama (v15) ----------
     Oda kuralları yukarıda değişmeden durur. Tablo kimliği: dönem~tablo~dönemlik ('genel' veya 'w<hafta>').
     Hafta, Türkiye saatiyle (UTC+3) pazartesi 00:00'da başlar ve sunucu saatine (request.time) göre denetlenir. */
  function rkTerm() { return '2026-2027'; }
  function rkBoards() { return {'haftalik': 145, 'ma-tur': 75, 'bh-tur': 75, 'kv-tur': 75, 'bl-tur': 75, 'oy-kapisma': 999, 'oy-arena': 999, 'oy-arena2': 999, 'bh-e1': 12, 'bh-e2': 12, 'bh-e3': 12, 'bh-e4': 12, 'bh-e5': 12, 'bh-e6': 12, 'bh-e7': 12, 'bh-e8': 12, 'ma-e1': 12, 'ma-e2': 12, 'ma-e3': 12, 'ma-e4': 12, 'ma-e5': 12, 'ma-e6': 12, 'ma-e7': 12, 'ma-e8': 12, 'ma-e9': 12, 'ma-e10': 12, 'ma-e11': 12, 'ma-e12': 12, 'bl-e1': 12, 'kv-basit': 4, 'kv-tabldot': 6, 'ma-s01': 10, 'ma-s02': 5, 'ma-s03': 6, 'ma-s04': 6, 'ma-s05': 7, 'ma-s06': 9, 'ma-s07': 5, 'ma-s08': 5, 'ma-s09': 5, 'ma-s10': 10, 'ma-s11': 8, 'ma-s12': 4, 'ma-s13': 10, 'ma-s14': 10, 'ma-s15': 9, 'bl-s1': 65, 'bs-s1': 106, 'bh-s1': 60}; }
  function rkVersion() { return 1; }
  function rkWeekNow() { return (request.time.toMillis() + 10800000 + 259200000) / 604800000; }
  function rkParts(table) { return table.split('~'); }
  function rkDynamic(b) { return b.matches('^ayar-(du|ar|cv)-(bh|ma|bl|kv)-(t|k|a)-(g|b|v)-([0-9]|1[012])-(10|15|20)-(0|15|20|30)$'); }
  function rkReadable(table) { return rkParts(table).size() == 3 && (rkParts(table)[1] in rkBoards() || rkDynamic(rkParts(table)[1])) && rkParts(table)[0].matches('^[0-9]{4}-[0-9]{4}$') && rkParts(table)[2].matches('^(genel|w[0-9]{1,6})$'); }
  function rkWritable(table) { return rkReadable(table) && rkParts(table)[0] == rkTerm() && (rkParts(table)[2] == 'genel' || rkParts(table)[2] == 'w' + string(rkWeekNow())); }

  match /rekorProfiller/{pid} {
   allow get: if signed() && (resource == null || resource.data.owner == request.auth.uid);
   allow list: if false;
   allow create: if signed() && pid.matches('^[a-z0-9]{20}$')
    && request.resource.data.keys().hasAll(['owner','status','gen']) && request.resource.data.keys().hasOnly(['owner','status','gen'])
    && request.resource.data.owner == request.auth.uid && request.resource.data.status == 'in' && request.resource.data.gen is int && request.resource.data.gen == 0;
   allow update: if signed() && resource.data.owner == request.auth.uid && resource.data.status != 'deleted'
    && request.resource.data.keys().hasAll(['owner','status','gen']) && request.resource.data.keys().hasOnly(['owner','status','gen'])
    && request.resource.data.owner == resource.data.owner
    && request.resource.data.gen is int && request.resource.data.gen == resource.data.gen + 1
    && ((resource.data.status == 'in' && request.resource.data.status in ['out','deleted'])
     || (resource.data.status == 'out' && request.resource.data.status in ['in','deleted']));
   allow delete: if false;
  }

  match /rekor/{table}/rows/{pid} {
   function prof() { return get(/databases/$(database)/documents/rekorProfiller/$(pid)).data; }
   function profAfter() { return getAfter(/databases/$(database)/documents/rekorProfiller/$(pid)).data; }
   function total() { let b = rkParts(table)[1]; return b in rkBoards() ? rkBoards()[b] : (b.matches('^ayar-cv-.*') ? int(b.split('-')[6]) : 999); }
   function shape(d) {
    return d.keys().hasAll(['name','correct','term','version','gen']) && d.keys().hasOnly(['name','correct','term','version','gen','rank','game','scope','total','contentVersion','week','dur'])
     && (!('rank' in d) || (d.rank is int && d.rank >= 1 && d.rank <= 5))
     && (rkParts(table)[1] == 'haftalik'
       ? (d.keys().hasAll(['game','scope','total','contentVersion','week']) && d.game == 'haftalik' && d.scope == 'butun' && d.total == 145 && d.contentVersion is string && d.contentVersion.matches('^hafta-[0-9]{1,2}-scope2-[0-9]{1,10}$') && d.week is int && rkParts(table)[2] == 'w' + string(d.week))
       : !d.keys().hasAny(['game','scope','total','contentVersion','week']))
     && (!('dur' in d) || ((rkParts(table)[1] == 'haftalik' || rkParts(table)[1].matches('^(ma|bh|kv|bl)-tur$')) && d.dur is int && d.dur >= 1 && d.dur <= 86400))
     && adOk(d.name)
     && d.correct is int && d.correct >= 0 && d.correct <= total()
     && d.term == rkTerm() && d.version == rkVersion() && d.gen is int;
   }
   function live() {
    return signed() && exists(/databases/$(database)/documents/rekorProfiller/$(pid))
     && prof().owner == request.auth.uid && prof().status == 'in' && profAfter().status == 'in'
     && prof().gen == profAfter().gen && request.resource.data.gen == prof().gen;
   }
   allow list, get: if signed() && rkReadable(table);
   allow create: if (rkParts(table)[1] != 'haftalik' || rkParts(table)[2] != 'genel') && rkWritable(table) && shape(request.resource.data) && live();
   allow update: if (rkParts(table)[1] != 'haftalik' || rkParts(table)[2] != 'genel') && rkWritable(table) && shape(request.resource.data) && live() && (
    resource.data.gen < prof().gen
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['correct','rank','dur']) && request.resource.data.correct > resource.data.correct)
    || ((rkParts(table)[1] == 'haftalik' || rkParts(table)[1].matches('^(ma|bh|kv|bl)-tur$')) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dur','rank']) && request.resource.data.diff(resource.data).affectedKeys().hasAny(['dur']) && 'dur' in request.resource.data && request.resource.data.correct == resource.data.correct && (!('dur' in resource.data) || request.resource.data.dur < resource.data.dur))
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rank']) && request.resource.data.diff(resource.data).affectedKeys().hasAny(['rank']) && request.resource.data.correct == resource.data.correct)
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) && request.resource.data.name != resource.data.name));
   allow delete: if signed() && exists(/databases/$(database)/documents/rekorProfiller/$(pid))
    && prof().owner == request.auth.uid && (prof().status in ['out','deleted'] || resource.data.gen < prof().gen);
  }

  /* ---------- Arkadaşlar ve davetler (v17) ----------
     Oyuncu kodu (pid) herkese açık bir ad kartıdır (yrKart); yalnız kodu bilen tek kartı okuyabilir, liste yok.
     Oyun adı hazır karakter listesinden seçilir (gerçek ad tutulmaz), bu yüzden kart ve çevrim içi bilgisi (yrDurum) giriş yapanlara açıktır; liste yoktur.
     Her hesap (uid) aynı anda tek aktif profil taşır (yrKim); sahiplik kuralda bu kayıttan doğrulanır. */
  function yrPidOk(p) { return p is string && p.matches('^[A-HJ-NP-Z2-9]{7}$'); }
  function yrKimOk(u) {
   return exists(/databases/$(database)/documents/yrKim/$(u))
    && exists(/databases/$(database)/documents/yrKart/$(get(/databases/$(database)/documents/yrKim/$(u)).data.pid))
    && get(/databases/$(database)/documents/yrKart/$(get(/databases/$(database)/documents/yrKim/$(u)).data.pid)).data.owner == u;
  }
  function yrHasKim() { return signed() && yrKimOk(request.auth.uid); }
  function yrMe() { return get(/databases/$(database)/documents/yrKim/$(request.auth.uid)).data.pid; }
  function yrPair(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
  function yrFrDoc(a, b) { return /databases/$(database)/documents/yrFr/$(yrPair(a, b)); }
  function yrBlocked(a, b) {
   return exists(/databases/$(database)/documents/yrEngel/$(a + '_' + b)) || exists(/databases/$(database)/documents/yrEngel/$(b + '_' + a));
  }
  function yrFriend(p) { return yrHasKim() && exists(yrFrDoc(yrMe(), p)) && get(yrFrDoc(yrMe(), p)).data.st == 'ok'; }
  function yrOwns(p) { return signed() && exists(/databases/$(database)/documents/yrKart/$(p)) && get(/databases/$(database)/documents/yrKart/$(p)).data.owner == request.auth.uid; }

  /* Oyun adı rezervasyonu: nm/{karakter_no}. Her karakter yalnız bir kişiye aittir. Liste yok.
     Bir cihaz (hesap) en çok 10 ad ayırabilir: ayrılan adlar nmSahip/{uid}.ks listesinde tutulur (aynı cihazı paylaşan profiller için). */
  match /nm/{k} {
   allow get: if signed();
   allow list: if false;
   allow create: if signed() && k.matches('^[0-9]{1,4}_[0-9]{1,4}$')
    && request.resource.data.keys().hasOnly(['u','t']) && request.resource.data.keys().hasAll(['u','t'])
    && request.resource.data.u == request.auth.uid && request.resource.data.t is int
    && existsAfter(/databases/$(database)/documents/nmSahip/$(request.auth.uid))
    && getAfter(/databases/$(database)/documents/nmSahip/$(request.auth.uid)).data.ks.hasAny([k]);
   allow update: if signed() && resource.data.u == request.auth.uid
    && request.resource.data.keys().hasOnly(['u','t']) && request.resource.data.u == request.auth.uid && request.resource.data.t is int;
   allow delete: if signed() && resource.data.u == request.auth.uid;
  }
  match /nmSahip/{uid} {
   allow get: if signed() && request.auth.uid == uid;
   allow list: if false;
   allow create: if signed() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['ks']) && request.resource.data.ks is list && request.resource.data.ks.size() <= 10;
   /* Liste büyüyebilir (en çok 10). Bir ad listeden yalnız o adın rezervasyonu silinmişse çıkarılabilir (c = çıkarılan ad). */
   allow update: if signed() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['ks','c']) && request.resource.data.ks is list && request.resource.data.ks.size() <= 10
    && (request.resource.data.ks.hasAll(resource.data.ks)
     || ('c' in request.resource.data && request.resource.data.c is string
         && request.resource.data.ks.toSet() == resource.data.ks.toSet().difference([request.resource.data.c].toSet())
         && !existsAfter(/databases/$(database)/documents/nm/$(request.resource.data.c))));
   allow delete: if signed() && request.auth.uid == uid;
  }

  /* Oyuncu kartı. Ayarlar: ri = arkadaşlık isteği almıyor, di = davet almıyor, gz = çevrim içi durumu gizli. */
  function kartAyarOk(d) {
   return (!('ri' in d) || d.ri is bool) && (!('di' in d) || d.di is bool) && (!('gz' in d) || d.gz is bool);
  }
  function kartAyar(p, k) {
   return exists(/databases/$(database)/documents/yrKart/$(p)) && get(/databases/$(database)/documents/yrKart/$(p)).data.get(k, false) == true;
  }
  match /yrKart/{pid} {
   allow get: if signed() && yrPidOk(pid);
   allow list: if false;
   allow create: if signed() && yrPidOk(pid)
    && request.resource.data.keys().hasOnly(['owner','nick','ri','di','gz']) && request.resource.data.keys().hasAll(['owner','nick'])
    && request.resource.data.owner == request.auth.uid
    && adOk(request.resource.data.nick) && kartAyarOk(request.resource.data);
   allow update: if signed() && resource.data.owner == request.auth.uid
    && request.resource.data.keys().hasOnly(['owner','nick','ri','di','gz']) && request.resource.data.owner == resource.data.owner
    && adOk(request.resource.data.nick) && kartAyarOk(request.resource.data);
   allow delete: if signed() && resource.data.owner == request.auth.uid;
  }

  match /yrKim/{uid} {
   allow get: if signed() && request.auth.uid == uid;
   allow list: if false;
   allow create, update: if signed() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['pid']) && request.resource.data.keys().hasAll(['pid'])
    && yrPidOk(request.resource.data.pid)
    && getAfter(/databases/$(database)/documents/yrKart/$(request.resource.data.pid)).data.owner == uid;
   allow delete: if signed() && request.auth.uid == uid;
  }

  match /yrDurum/{pid} {
   allow get: if signed() && yrPidOk(pid);
   allow list: if false;
   allow create, update: if signed() && yrOwns(pid) && !kartAyar(pid, 'gz')
    && request.resource.data.keys().hasOnly(['seen']) && request.resource.data.keys().hasAll(['seen'])
    && request.resource.data.seen == request.time;
   allow delete: if signed() && yrOwns(pid);
  }

  match /yrFr/{key} {
   function ok(d) {
    return d.keys().hasOnly(['a','b','by','st','ts']) && d.keys().hasAll(['a','b','by','st','ts'])
     && yrPidOk(d.a) && yrPidOk(d.b) && d.a < d.b && key == d.a + '_' + d.b
     && (d.by == d.a || d.by == d.b) && d.st in ['p','ok'] && d.ts == request.time;
   }
   allow get: if yrHasKim() && (resource.data.a == yrMe() || resource.data.b == yrMe());
   allow list: if yrHasKim() && (resource.data.a == yrMe() || resource.data.b == yrMe());
   allow create: if yrHasKim() && ok(request.resource.data) && request.resource.data.st == 'p'
    && request.resource.data.by == yrMe()
    && exists(/databases/$(database)/documents/yrKart/$(request.resource.data.a))
    && exists(/databases/$(database)/documents/yrKart/$(request.resource.data.b))
    && !yrBlocked(request.resource.data.a, request.resource.data.b)
    && !kartAyar(request.resource.data.a == yrMe() ? request.resource.data.b : request.resource.data.a, 'ri');
   allow update: if yrHasKim() && resource.data.st == 'p' && resource.data.by != yrMe()
    && (resource.data.a == yrMe() || resource.data.b == yrMe())
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','ts'])
    && request.resource.data.st == 'ok' && request.resource.data.ts == request.time
    && !yrBlocked(resource.data.a, resource.data.b);
   allow delete: if yrHasKim() && (resource.data.a == yrMe() || resource.data.b == yrMe());
  }

  match /yrEngel/{id} {
   allow get, list: if yrHasKim() && resource.data.by == yrMe();
   allow create: if yrHasKim() && request.resource.data.keys().hasOnly(['by','to']) && request.resource.data.keys().hasAll(['by','to'])
    && request.resource.data.by == yrMe() && yrPidOk(request.resource.data.to) && request.resource.data.to != request.resource.data.by
    && id == request.resource.data.by + '_' + request.resource.data.to;
   allow update: if false;
   allow delete: if yrHasKim() && resource.data.by == yrMe();
  }

  /* Davet: gönderen kurduğu ya da içinde bulunduğu (12.11), henüz başlamamış odaya ve kabul edilmiş arkadaşına davet yazar. Kimlik: gönderen_alıcı_oda. */
  match /yrDav/{id} {
   function ok(d) {
    return d.keys().hasOnly(['from','to','nick','code','rid','subject','mode','ts','sf']) && d.keys().hasAll(['from','to','nick','code','rid','subject','mode','ts'])
     && (!('sf' in d) || (d.sf is string && d.sf.matches('^[0-9]{4}$')))
     && yrPidOk(d.from) && yrPidOk(d.to) && d.from != d.to && d.code is string && d.code.matches('^[A-Z0-9]{3,10}$')
     && id == d.from + '_' + d.to + '_' + d.code
     && adOk(d.nick)
     && d.subject is string && d.subject.size() <= 30 && d.mode in ['race','duel','arena'] && d.rid is int && d.ts == request.time;
   }
   allow get, list: if yrHasKim() && (resource.data.to == yrMe() || resource.data.from == yrMe());
   allow create: if yrHasKim() && ok(request.resource.data) && request.resource.data.from == yrMe()
    && yrFriend(request.resource.data.to) && !yrBlocked(request.resource.data.from, request.resource.data.to) && !kartAyar(request.resource.data.to, 'di')
    && exists(/databases/$(database)/documents/oyunOdalari/$(request.resource.data.code))
    && (get(/databases/$(database)/documents/oyunOdalari/$(request.resource.data.code)).data.host == request.auth.uid
        || exists(/databases/$(database)/documents/oyunOdalari/$(request.resource.data.code)/players/$(request.auth.uid)))
    && (!('sf' in request.resource.data) || request.resource.data.sf == get(/databases/$(database)/documents/oyunOdalari/$(request.resource.data.code)/gizli/sifre).data.s)
    && get(/databases/$(database)/documents/oyunOdalari/$(request.resource.data.code)).data.created == request.resource.data.rid
    && get(/databases/$(database)/documents/oyunOdalari/$(request.resource.data.code)).data.status == 'lobby'
    && get(/databases/$(database)/documents/oyunOdalari/$(request.resource.data.code)).data.mode == request.resource.data.mode;
   allow update: if false;
   allow delete: if yrHasKim() && (resource.data.to == yrMe() || resource.data.from == yrMe());
  }

  /* Koşulların kabul kaydı: cihaz kimliği başına tek belge. Yalnız sahibi yazar, okur, siler. */
  match /kabul/{uid} {
   allow get, delete: if signed() && request.auth.uid == uid;
   allow list: if false;
   allow create, update: if signed() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['s','y','t']) && request.resource.data.keys().hasAll(['s','y','t'])
    && request.resource.data.s is int && request.resource.data.s >= 1 && request.resource.data.s <= 100
    && request.resource.data.y in ['b','k']
    && request.resource.data.t == request.time;
  }
 }
}
