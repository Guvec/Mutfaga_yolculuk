rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  /* Oyun adı yalnız Uygulamadaki hazır karakter listesinden olabilir (serbest metin yok). Misafir adı: "👤 Misafir" veya "👤 Misafir 123". */
  function adOk(n) {
   return n is string && (n.matches('^👤 Misafir( [0-9]{3})?$') || n.matches('^(🐼 Cesur Panda|🦊 Kurnaz Tilki|🦘 Zıpzıp Kanguru|🐯 Güçlü Kaplan|🦁 Kral Aslan|🐻 Tonton Ayıcık|🐨 Sevimli Koala|🐰 Hızlı Tavşan|🐱 Meraklı Kedi|🐧 Neşeli Penguen|🦉 Bilge Baykuş|🦅 Keskin Kartal|🐬 Akıllı Yunus|🦒 Şık Zürafa|🦓 Çizgili Zebra|🦄 Sihirli Tekboynuz|🦖 Kükreyen Dinozor|🐙 Becerikli Ahtapot|🦋 Renkli Kelebek|🐝 Çalışkan Arı|🐞 Şanslı Uğurböceği|🦜 Konuşkan Papağan|🐿️ Çevik Sincap|🦔 Minik Kirpi|🐺 Yiğit Kurt|🦌 Zarif Geyik|🐴 Asil At|🦈 Korkusuz Köpekbalığı|🐊 Yaman Timsah|🦩 Pembe Flamingo|🐹 Tatlı Hamster|🐸 Yeşil Kurbağa|🐠 Tropik Balık|🐆 Şimşek Çita|🦚 Renkli Tavuskuşu|🦦 Oyuncu Susamuru|🦀 Yanyan Yengeç|🍎 Kırmızı Elma|🍊 Vitaminli Portakal|🍋 Sarı Limon|🍉 Serin Karpuz|🍇 Mor Üzüm|🍓 Tatlı Çilek|🍒 Dallı Kiraz|🥭 Sarı Mango|🍍 Taçlı Ananas|🥥 Tropik Hindistancevizi|🥝 Yeşil Kivi|🍈 Bal Kavun|🍅 Al Domates|🥑 Kremalı Avokado|🥦 Sağlıklı Brokoli|🥬 Taze Marul|🌶️ Acı Biber|🌽 Altın Mısır|🥕 Turuncu Havuç|🧄 Şifalı Sarımsak|🧅 Halka Soğan|🥔 Fırın Patates|🌰 Közlenmiş Kestane|🍕 Sıcak Pizza|🍔 Lezzetli Hamburger|🍟 Çıtır Kızartma|🍿 Sevimli Mısır|🧁 Kabarık Kek|🍰 Çilekli Pasta|🎂 Mumlu Pasta|🍩 Şekerli Donut|🍪 Çikolatalı Kurabiye|🍫 Sütlü Çikolata|🍬 Renkli Şeker|🍭 Rengârenk Lolipop|🍦 Külah Dondurma|🥞 Ballı Pankek|🧇 Kare Waffle|🥐 Tereyağlı Kruvasan|🧀 Köy Peyniri|🍯 Süzme Bal|🥛 Taze Süt|🍞 Fırından Ekmek|🥪 Doyurucu Sandviç|🍝 Kıvırcık Makarna|🍜 Buharlı Çorba|🥗 Yeşil Salata|🧃 Kutulu Meyve Suyu|🥧 Elmalı Turta|⭐ Parlak Yıldız|🌟 Işıltılı Yıldız|🌠 Kayan Yıldız|🌙 Gümüş Ay|☀️ Sıcak Güneş|🌈 Renkli Gökkuşağı|⚡ Hızlı Şimşek|❄️ Beyaz Kartanesi|🌋 Coşkun Yanardağ|🌊 Dalgalı Deniz|🔥 Parlayan Alev|🌪️ Güçlü Kasırga|🌍 Güzel Dünya|🪐 Halkalı Satürn|☄️ Uçan Kuyrukluyıldız|💎 Parıltılı Elmas|☁️ Pamuk Bulut|⛄ Neşeli Kardan Adam|🏔️ Karlı Dağ|🌸 Bahar Çiçeği|🌻 Güler Ayçiçeği|🌷 Narin Lale|🌹 Kırmızı Gül|🌺 Egzotik Çiçek|🌼 Sarı Papatya|💐 Mis Kokulu Buket|🌵 Çöl Kaktüsü|🌳 Koca Çınar|🌲 Ulu Çam|🌴 Tatil Palmiyesi|🍀 Dört Yapraklı Yonca|🍁 Sonbahar Yaprağı|🌱 Yeni Filiz|🌾 Bereketli